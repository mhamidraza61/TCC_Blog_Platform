PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/tcc_blog?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_string
NODE_ENV=development

# Get these from cloudinary.com dashboard after creating a free account
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Set this to your deployed frontend URL once you deploy (Week 4).
# Used for CORS — leave as localhost for local development.
CLIENT_URL=http://localhost:5173
